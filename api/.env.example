# Copy this file to .env.local in public_html/ on the HostAtom server.
# DO NOT commit .env.local — it contains secrets.

# MySQL connection (HostAtom local DB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=checkk_dbdemo
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Optional: Unix socket for fastest local connection (DirectAdmin servers usually have one)
# DB_SOCKET_PATH=/var/lib/mysql/mysql.sock

# Session signing secret. Must match the value previously used by the Vercel/Next.js API
# so existing admin sessions in localStorage stay valid. If you don't know the previous
# value, set anything strong here — admins will need to log in again.
APP_SECRET=change_this_to_a_long_random_string
