name: Deploy to GitHub Pages (with PAT)

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pages: write
      id-token: write

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "18"
          cache: "npm"

      - name: Install dependencies
        run: npm ci

      - name: Build project
        run: npm run build:prod
        env:
          NEXT_PUBLIC_BASE_PATH: /startup-nextjs

      - name: Deploy to GitHub Pages
        uses: peaceiris/actions-gh-pages@v3
        if: github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master'
        with:
          # ใช้ Personal Access Token แทน GITHUB_TOKEN
          # ต้องสร้าง secret ชื่อ GH_PAGES_TOKEN ใน Repository Settings
          github_token: ${{ secrets.GH_PAGES_TOKEN }}
          publish_dir: ./dist
          cname: # Optional: add your custom domain here if you have one

