# .htaccess สำหรับ Next.js Static Export

RewriteEngine On

# Force HTTPS + www in one pass (covers all combinations)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^checkkub\.com$ [NC]
RewriteRule ^(.*)$ https://www.checkkub.com/$1 [R=301,L]

# API routes with ID parameter — must come BEFORE the generic api/ rule
RewriteRule ^api/banners/([0-9]+)/?$ api/banners.php?id=$1 [QSA,L]
RewriteRule ^api/cars/([^/]+)/?$     api/cars.php?id=$1    [QSA,L]
RewriteRule ^api/blogs/([0-9]+)/?$   api/blogs.php?id=$1   [QSA,L]

# Pass all /api/* requests directly to PHP
RewriteRule ^api/ - [L]

# Remove trailing slash (non-directories only)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [R=301,L]

# Serve real files as-is
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve Next.js .html pages
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Dynamic routes
RewriteRule ^blog-details/[^/]+/?$ blog-details/detail.html [L]
RewriteRule ^cars/[^/]+/?$ cars/detail.html [L]

# Fallback
RewriteRule ^ index.html [L]
