# .htaccess สำหรับ Next.js

# Enable Rewrite Engine
RewriteEngine On

# Handle Next.js routing - redirect to index.html for client-side routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ /index.html [L]

# Prevent directory listing
Options -Indexes

# Allow access to static files
<FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|css|js|woff|woff2|ttf|eot|json)$">
    Order allow,deny
    Allow from all
</FilesMatch>

