# .htaccess สำหรับ Next.js Static Export
# ใช้เมื่อ deploy ผ่าน GitHub Actions (static files)

# Enable Rewrite Engine
RewriteEngine On

# Allow all access (แก้ปัญหา Forbidden)
# สำหรับ Apache 2.4+
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# สำหรับ Apache 2.2 หรือเก่ากว่า
<IfModule !mod_authz_core.c>
    Order allow,deny
    Allow from all
</IfModule>

# Handle Next.js static routing - redirect to index.html for client-side routing
# This allows Next.js client-side routing to handle dynamic routes like /cars/[id]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]

# Prevent directory listing
Options -Indexes

# Allow access to static files
<FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|css|js|woff|woff2|ttf|eot|json|html|htm|xml|txt)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

