# .htaccess สำหรับ Next.js Static Export
# ใช้เมื่อ deploy เป็นไฟล์ Static (.html, .js, .css)

RewriteEngine On

# Redirect non-www to www (301 permanent)
RewriteCond %{HTTP_HOST} ^checkkub\.com$ [NC]
RewriteRule ^(.*)$ https://www.checkkub.com/$1 [R=301,L]

# Pass all /api/* requests directly to PHP — do NOT rewrite to index.html
RewriteRule ^api/ - [L]

# Remove trailing slash (only for non-directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# Serve real files as-is (files only, not directories)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve Next.js .html pages — handles any depth (admin/dashboard, cars, about…).
# Must be before dynamic-route rules so multi-segment static pages are served first.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Dynamic routes
RewriteRule ^blog-details/[^/]+/?$ blog-details/detail.html [L]
RewriteRule ^cars/[^/]+/?$ cars/detail.html [L]

# Fallback — all other paths served by Next.js client-side router
RewriteRule ^ index.html [L]
