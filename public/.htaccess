# .htaccess สำหรับ Next.js Static Export
# ใช้เมื่อ deploy เป็นไฟล์ Static (.html, .js, .css)

RewriteEngine On

# Pass all /api/* requests directly to PHP — do NOT rewrite to index.html
RewriteRule ^api/ - [L]

# 1. จัดการ Trailing Slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)/$ /$1 [L,R=301]

# 2. ให้ Apache เปิดไฟล์จริงๆ ถ้าไฟล์นั้นมีอยู่
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. จัดการ SPA Routing สำหรับ Dynamic Routes

# สำหรับ Blog Details: /blog-details/52 -> /blog-details/detail.html
RewriteRule ^blog-details/[^/]+$ blog-details/detail.html [L]

# สำหรับ Car Details: /cars/encoded-id -> /cars/detail.html
RewriteRule ^cars/[^/]+$ cars/detail.html [L]

# 4. สำหรับหน้าอื่นๆ ที่หาไม่เจอ ให้ส่งไปที่ index.html
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

RewriteRule ^ index.html [L]
